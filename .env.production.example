COMPOSE_PROJECT_NAME=soundseek

# Use a domain name here for automatic HTTPS, for example: music.example.com
SITE_ADDRESS=music.example.com

MYSQL_DATABASE=soundseek
MYSQL_USER=soundseek
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

AGENT_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-token
MINIO_ACCESS_KEY=replace-with-a-minio-access-key
MINIO_SECRET_KEY=replace-with-a-long-minio-secret

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
BOCHA_API_KEY=
LASTFM_API_KEY=
WIKIMEDIA_RESEARCH_ENABLED=true

MILVUS_URI=http://milvus:19530
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Single Apple iTunes preview catalog; no cross-region fallback.
APPLE_ITUNES_STOREFRONT=US

# Account SMTP settings. Set the public URL to this deployment's actual HTTPS origin.
AUTH_MAIL_ENABLED=false
AUTH_MAIL_FROM=
AUTH_MAIL_ENCRYPTION_KEY=
AUTH_PUBLIC_BASE_URL=https://music.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
KNOWLEDGE_MAINTAINER_IDS=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
