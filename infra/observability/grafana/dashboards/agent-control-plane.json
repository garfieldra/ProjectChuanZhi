{
  "title": "SoundSeek Agent Control Plane",
  "uid": "soundseek-agent-control-plane",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id":1,"type":"stat","title":"Agent Runs Created","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(increase(soundseek_agent_runs_created_total[1h]))","refId":"A"}],"gridPos":{"h":6,"w":6,"x":0,"y":0}},
    {"id":2,"type":"stat","title":"Agent Completion Rate","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(soundseek_agent_runs_completed_total[15m])) / clamp_min(sum(rate(soundseek_agent_runs_claimed_total[15m])), 0.001)","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percentunit"}},"gridPos":{"h":6,"w":6,"x":6,"y":0}},
    {"id":3,"type":"stat","title":"Retries","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(increase(soundseek_agent_runs_retries_total[1h]))","refId":"A"}],"gridPos":{"h":6,"w":6,"x":12,"y":0}},
    {"id":4,"type":"stat","title":"Agent DLQ","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"rabbitmq_detailed_queue_messages{queue=\"soundseek.agent-runs.dlq\"}","refId":"A"}],"gridPos":{"h":6,"w":6,"x":18,"y":0}},
    {"id":5,"type":"timeseries","title":"Queue Depth","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"rabbitmq_detailed_queue_messages{queue=~\"soundseek.agent-.*\"}","legendFormat":"{{queue}}","refId":"A"}],"gridPos":{"h":8,"w":12,"x":0,"y":6}},
    {"id":6,"type":"timeseries","title":"Run Duration","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"rate(soundseek_agent_runs_duration_seconds_sum[5m]) / clamp_min(rate(soundseek_agent_runs_duration_seconds_count[5m]), 0.001)","legendFormat":"{{type}} avg","refId":"A"}],"gridPos":{"h":8,"w":12,"x":12,"y":6}},
    {"id":7,"type":"timeseries","title":"RabbitMQ Publish Outcomes","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"rate(rabbitmq_global_messages_confirmed_total[5m])","legendFormat":"confirmed","refId":"A"},{"expr":"rate(rabbitmq_global_messages_unroutable_dropped_total[5m])","legendFormat":"unroutable","refId":"B"}],"gridPos":{"h":8,"w":24,"x":0,"y":14}}
  ]
}
